rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own custom bingo cards
    match /customBingoCards/{cardId} {
      // Allow anyone to create new cards (anonymous usage)
      allow create: if true;

      // Allow reading all public cards
      allow read: if resource.data.isPublic == true;

      // Allow reading, updating, and deleting cards based on a simple user matching
      // Note: This is a simplified approach for anonymous users
      // In a production app, you'd want proper authentication
      allow read, update, delete: if true;
    }
  }
}